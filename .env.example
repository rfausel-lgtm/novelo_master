# O Novelo Master — variáveis de ambiente (exemplo)
# Copie para .env.local e preencha. NUNCA versione .env* (exceto este exemplo).
#
# URL pública do site (usada em canonical, sitemap e OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Opcional: incluir registros com review_status != published no build (apenas dev).
NOVELO_INCLUDE_DRAFTS=false
